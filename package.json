{
  "name": "amcmail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AMC Mail: multi-domain temporary mail and SMTP bounce monitor for Al Muthi Creative on Cloudflare Workers, Email Routing, and D1.",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply amcmail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply amcmail-db --remote",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "postal-mime": "^4.2.1"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
